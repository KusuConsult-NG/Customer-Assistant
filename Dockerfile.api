# Multi-stage Dockerfile for NestJS API Server (@ace/api)
FROM node:20-alpine AS base
WORKDIR /app
RUN apk add --no-libc-compat python3 make g++

FROM base AS dependencies
COPY package.json package-lock.json ./
COPY packages/database/package.json ./packages/database/
COPY packages/orchestrator/package.json ./packages/orchestrator/
COPY packages/pdf-generator/package.json ./packages/pdf-generator/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/telephony-sdk/package.json ./packages/telephony-sdk/
COPY packages/whatsapp-sdk/package.json ./packages/whatsapp-sdk/
COPY apps/api/package.json ./apps/api/
RUN npm ci

FROM dependencies AS build
COPY . .
RUN npx prisma generate --schema=packages/database/prisma/schema.prisma
RUN npm run build --workspace=apps/api

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4000

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/packages ./packages
COPY --from=build /app/package.json ./package.json

EXPOSE 4000
CMD ["node", "apps/api/dist/main.js"]
