# Copy to deploy.env, fill in, then:  sudo ./install.sh
# Lives only on the server (chmod 600). Never commit it, never paste it in chat.
#
# Everything NOT listed under "The kit" is passed straight to the app. To carry
# a setting over from Render, add it here with the same name and value.

# ── The kit ──────────────────────────────────────────────────────────────
# The public name of the dashboard AND the API (one domain; Caddy splits it).
# Its DNS A record must already point at this server for HTTPS to be issued.
DOMAIN=contact.plateaustate.gov.ng
# Let's Encrypt account e-mail (expiry notices). Not shown to anyone else.
ACME_EMAIL=
# Production (Supabase) is PostgreSQL 17.6. Dump/restore cannot go DOWN a
# major version, so 17 — not 16 — is what the data can move onto.
PG_VERSION=17
QDRANT_VERSION=v1.13.6
BACKUP_KEEP_DAYS=14
SSH_PORT=22

# ── Copied from Render (Settings → Environment of ace-api), SAME values ──
# ENCRYPTION_KEY MUST be the production value: every stored provider
# credential (WhatsApp tokens, ElevenLabs key, SIP password) is encrypted with
# it, and a different key turns all of them into unreadable ciphertext.
ENCRYPTION_KEY=
# Keeping these the same keeps everyone signed in across the move.
JWT_SECRET=
JWT_REFRESH_SECRET=
OPENAI_API_KEY=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
RESEND_API_KEY=
# Twilio, if any agency still uses it:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# ── The server's own voice line (Phase 2; leave 0 until Phase 3 testing) ──
LOCAL_VOICE_PIPELINE=0
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# The agency the toll-free line belongs to (its slug), for a bridge whose
# carrier delivers every call to one extension.
LOCAL_VOICE_ORGANIZATION_SLUG=

# ── For migrate-from-supabase.sh only (not passed to the app) ──
# Supabase → Project Settings → Database → Connection string, DIRECT (5432).
SOURCE_DATABASE_URL=
SOURCE_SUPABASE_URL=
SOURCE_SUPABASE_SERVICE_ROLE_KEY=
