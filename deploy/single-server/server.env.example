# The single server's settings. Copy to server.env, fill in, chmod 600.
# NEVER commit server.env. Read as text by docker compose — quotes are not
# needed and a value is everything after the first "=".
#
# Not listed because docker-compose.yml sets them from this layout and they
# must not be overridden: DATABASE_URL, DIRECT_URL, REDIS_URL, QDRANT_URL,
# API_BASE_URL, WEB_BASE_URL, CORS_ORIGIN, TRUST_PROXY, STORAGE_DIR, and the
# SUPABASE_* pair (blanked: files are kept on this server).

# ── This server ───────────────────────────────────────────────────────────────
# The dashboard and the API are both served from https://DOMAIN.
# Example: care.example.org (no https://). Either:
#   - ports 80/443 open to everyone: DOMAIN's DNS A record points at this
#     server and Caddy gets the HTTPS certificate itself; or
#   - NO inbound web port (named Cloudflare Tunnel, below): DOMAIN is the
#     public hostname you gave the tunnel in Cloudflare.
DOMAIN=
# Where Let's Encrypt sends certificate-expiry warnings. Required either way.
ACME_EMAIL=

# ── Named Cloudflare Tunnel (no inbound web port) ─────────────────────────────
# The tunnel's token, from Cloudflare (Zero Trust -> Networks -> Tunnels ->
# the tunnel -> the install command: the long value after --token). A secret:
# whoever holds it can serve your domain. Never paste it into chat or a ticket.
# Empty: no tunnel, and ports 80/443 must be open instead.
CLOUDFLARE_TUNNEL_TOKEN=
# With the tunnel: http://:8081 (Caddy then asks for no certificate; Cloudflare
# holds it). Without: leave empty.
CADDY_PUBLIC_SITE=

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
QDRANT_API_KEY=

# ── Copied from the current API environment (Render → ace-api → Environment) ─
# Use the SAME values. ENCRYPTION_KEY above all: every stored WhatsApp and
# phone-line credential is encrypted with it, and a different key leaves them
# unreadable — every line goes dark with an authentication error.
ENCRYPTION_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
OPENAI_API_KEY=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
DEEPGRAM_API_KEY=
# One email provider (see .env.example for the others):
RESEND_API_KEY=
# Only if the deployment uses Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Welcoming returning callers by name ──────────────────────────────────────
# Shared with the phone bridge (infra/sip-bridge/bridge.env, same value): it
# asks this server who is calling before the agent answers. Letters, digits,
# - and _ only, 24+ characters: openssl rand -hex 24. Empty = every caller is
# greeted as new, as before.
SIP_BRIDGE_SECRET=

# ── The server's own voice line (Phase 3; OFF until proven) ──────────────────
# Answers calls here (Deepgram → OpenAI → Azure's Nigerian voice) instead of
# ElevenLabs, which stays the automatic fallback. Leave LOCAL_VOICE_PIPELINE=0
# until the live-call checks in PHASE3.md have passed. Needs DEEPGRAM_API_KEY
# and OPENAI_API_KEY above as well.
LOCAL_VOICE_PIPELINE=0
# Shared with the phone bridge (infra/sip-bridge/bridge.env, same value):
# openssl rand -hex 24.
LOCAL_VOICE_SECRET=
# The agency that answers the toll-free line (its slug, as in the dashboard URL).
LOCAL_VOICE_ORGANIZATION_SLUG=
# Azure Speech: the key and region from the Azure portal (Speech service).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional. Speaking speed (default -5%) and voice (default the Nigerian
# English voice). Changing them needs no rebuild, only a restart of the API.
AZURE_TTS_RATE=
AZURE_TTS_VOICE=
# Optional. "female": every call is answered by a female Plateau assistant
# (her name, the Governor's introduction and the female voice SPITCH_FEMALE_VOICE);
# "male" likewise; empty = either, chosen per call. An api restart applies it.
LOCAL_VOICE_ASSISTANT_GENDER=
# Optional. gpt-4.1 by default (first words in about 0.9 s with the call
# script, measured on the server 28 Nov 2026; gpt-4o about 1.0–1.5 s). Leave
# empty to use it. Compare another with conversation-check.js before keeping it.
LOCAL_VOICE_LLM_MODEL=
# Optional, all three apply with an api restart (no rebuild):
# - How the voice says words it gets wrong: Word=Spelling, separated by ;
#   e.g. "Plateau=Plah-toe". Listen first with
#   node apps/api/dist/voice-local/pronunciation-takes.js Plateau "Plah-toe"
LOCAL_VOICE_PRONOUNCE=
# - While a caller reads out a number or spells a name, how long they must be
#   quiet before it counts as finished (ms, default 2000; 0 = off). Review the
#   old line's words in the current voice first with
#   node apps/api/dist/voice-local/pronunciation-review.js <agency-slug>
LOCAL_VOICE_SPELLING_PATIENCE_MS=
# - The longest a reply's first sentence waits for the rest (ms, 0–5000,
#   default 2500). Lower = less silence after the caller; 0 = start at once.
LOCAL_VOICE_PREBUFFER_WAIT_MS=
# - 1 = send commas in short sentences to Spitch (natural pauses). Listen on a
#   test call before keeping it.
SPITCH_KEEP_COMMAS=

# Any other variable set on Render that is not in the "not listed" set above
# goes here too, unchanged (LLM_BASE_URL, LLM_CHAT_MODEL, TURN_*, …).

# ── Building on a network that inspects TLS ───────────────────────────────────
# Only if `./deploy.sh` fails with SELF_SIGNED_CERT_IN_CHAIN, or the API cannot
# reach OpenAI/ElevenLabs/Meta with that error: the path to the network's CA
# certificate (PEM). Used while the images are built AND by the running API.
# Never "fixed" by turning certificate checks off.
EXTRA_CA_CERT=

# ── Monitoring (the system health page and the monitor outside this server) ──
# The same value as the GitHub repository secret MONITOR_TOKEN: the monitor
# (.github/workflows/production-monitor.yml) reports each check to the system
# health page with it. openssl rand -hex 24 (24+ characters). Empty: alerts
# still open as GitHub issues, but the page shows the monitor as not reporting.
MONITOR_TOKEN=

# ── Backups (backup.sh) ───────────────────────────────────────────────────────
# Days of nightly backups kept on this server.
BACKUP_KEEP_DAYS=14
# Where each night's backup is COPIED OFF this server — a backup on the same
# disk is lost with the disk. An rclone remote ("name:path"), configured once
# with `rclone config` (S3-compatible storage, Google Drive, another server
# over SFTP, …). Empty: backups stay on this server only, and backup.sh says
# so in its log every night.
BACKUP_REMOTE=
# Optional. Passphrase used by backup.sh to encrypt the nightly backup tarball
# (AES-256-CBC + PBKDF2) before uploading to BACKUP_REMOTE. Generate with:
# openssl rand -hex 32 and store offline in a password manager (losing this key
# makes encrypted off-server backups unrecoverable).
BACKUP_ENCRYPTION_KEY=
