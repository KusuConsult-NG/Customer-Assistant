# Where the data is coming FROM: the current Supabase project. Used only by
# migrate-from-supabase.sh, only read from, and deleted after the move.
# Copy to migrate.env, fill in, chmod 600. NEVER commit migrate.env.

# Supabase → Project Settings → Database → Connection string → "Session pooler"
# (port 5432). Not the "Transaction pooler" (6543), which pg_dump cannot use,
# and not "Direct connection", which is IPv6-only and many servers cannot reach.
SOURCE_DATABASE_URL=

# Supabase → Project Settings → API: the project URL and the service_role key.
SOURCE_SUPABASE_URL=
SOURCE_SUPABASE_SERVICE_ROLE_KEY=
