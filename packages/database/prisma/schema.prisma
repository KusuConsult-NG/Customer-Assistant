datasource db {
  provider  = "postgresql"
  // DATABASE_URL  → Supabase connection POOLER (Supavisor) — used at runtime
  // DIRECT_URL    → Supabase direct DB connection — used by `prisma migrate` only
  // Get both from: Supabase Dashboard → Settings → Database → Connection string
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum IndustryType {
  HOSPITAL
  CLINIC
  HOTEL
  RESTAURANT
  SCHOOL
  UNIVERSITY
  CHURCH
  LAW_FIRM
  REAL_ESTATE
  LOGISTICS
  BANK
  INSURANCE
  GOVERNMENT
  SALON_SPA
  SME
  ENTERPRISE
  OTHER
}

// Must stay in sync with ChannelType in packages/shared-types/src/index.ts.
// MESSENGER existed only in the TypeScript enum, so writing a Messenger
// conversation failed at the database layer.
enum ChannelType {
  VOICE
  WHATSAPP
  WEBCHAT
  SMS
  EMAIL
  INSTAGRAM
  TELEGRAM
  MESSENGER
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  QUEUED
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  BUSY
  NO_ANSWER
}

enum MessageSender {
  CUSTOMER
  AI
  HUMAN_AGENT
  SYSTEM
}

enum HandoffReason {
  LOW_CONFIDENCE
  CUSTOMER_REQUEST
  TOOL_FAILURE
  COMPLEX_QUERY
  URGENT_ESCALATION
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum DealStage {
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Must stay in sync with TelephonyProviderType in packages/shared-types/src/index.ts.
// MTN_ENTERPRISE_SIP and AIRTEL_BUSINESS_SIP had TypeScript enum members and full
// provider implementations in @ace/telephony-sdk, but no database values — so
// selecting either provider threw on the CallLog insert.
enum TelephonyProviderType {
  TWILIO
  PLIVO
  TELNYX
  AFRICAS_TALKING
  NIGERIA_CARRIER_FORWARD
  MTN_ENTERPRISE_SIP
  AIRTEL_BUSINESS_SIP
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  RESCHEDULED
  COMPLETED
  NO_SHOW
}

enum DocStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
}

model Organization {
  id                   String       @id @default(uuid())
  name                 String
  slug                 String       @unique
  industry             IndustryType @default(SME)
  country              String       @default("Nigeria")
  timezone             String       @default("Africa/Lagos")
  phone                String?
  logoUrl              String?
  aiPersonaPrompt      String?      @db.Text
  welcomeMessage       String?      @db.Text
  // ─── Embedded widget appearance ────────────────────────────────────────────
  // The Widget Generator page offered colour and position controls that had
  // nowhere to persist to — the API returned hardcoded values, so an operator
  // could set their brand colour, get a "saved" toast, and see nothing change
  // on their site. These columns are where those controls now land.
  widgetPrimaryColor   String?
  widgetSecondaryColor String?
  widgetPosition       String?      @default("bottom-right")
  // ─── Subscription & Billing ────────────────────────────────────────────────
  // Updated by BillingService when Paystack fires charge.success webhook.
  // subscriptionPlan matches SubscriptionPlan enum values: STARTER | PROFESSIONAL | BUSINESS | ENTERPRISE
  subscriptionPlan     String?
  subscriptionStatus   String?      @default("TRIAL") // TRIAL | ACTIVE | CANCELLED | PAST_DUE
  subscriptionRenewsAt DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  users                User[]
  apiKeys              ApiKey[]
  telephonyConfigs     TelephonyConfig[]
  hostedAgentConfig    HostedAgentConfig?
  whatsAppConfigs      WhatsAppConfig[]
  contacts             Contact[]
  companies            Company[]
  leads                Lead[]
  deals                Deal[]
  tickets              Ticket[]
  conversations        Conversation[]
  callLogs             CallLog[]
  knowledgeDocuments   KnowledgeDocument[]
  bookings             Booking[]
  reservations         Reservation[]
  calendarIntegrations CalendarIntegration[]
  faqEntries           FaqEntry[]
  whatsAppTemplates    WhatsAppTemplate[]
  broadcastCampaigns   BroadcastCampaign[]
  workflows            Workflow[]
  selfieRequests       SelfieRequest[]

  // White-label webhook settings
  webhookUrl           String?
  enabledWebhookEvents String[] @default([])

  // ─── Customer payment collection details ───────────────────────────────────
  // Used by the AI assistant when a customer asks how to pay. These MUST be
  // configured per organization: the assistant previously read out a hardcoded
  // "Providus Bank 9928374102" account and invented USSD codes, which would have
  // directed real customers to send money to an account nobody controls.
  // When these are null the assistant says it will have a human follow up instead
  // of inventing details.
  payoutBankName      String?
  payoutAccountName   String?
  payoutAccountNumber String?
  payoutUssdCode      String?

  @@map("organizations")
}

model User {
  id                     String       @id @default(uuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email                  String       @unique
  passwordHash           String
  fullName               String
  role                   UserRole     @default(AGENT)
  avatarUrl              String?
  isActive               Boolean      @default(true)
  // ─── Password Reset ──────────────────────────────────────────────────────
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  // ─── Email Verification ──────────────────────────────────────────────────
  emailVerifiedAt        DateTime?
  emailVerifyToken       String?      @unique
  emailVerifyExpiresAt   DateTime?
  // ─── Session revocation ──────────────────────────────────────────────────
  // Embedded in every issued JWT and re-checked by JwtStrategy on each request.
  // Incrementing it immediately invalidates all outstanding access and refresh
  // tokens for this user (logout, password change, password reset).
  tokenVersion           Int          @default(0)
  // ─── Brute-force protection ──────────────────────────────────────────────
  // Per-ACCOUNT lockout. A per-IP rate limit cannot stop distributed credential
  // stuffing aimed at one account, and it locks out legitimate users who share a
  // NAT address. Cleared on successful sign-in and on password reset.
  failedLoginAttempts    Int          @default(0)
  lockedUntil            DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  assignedConversations Conversation[] @relation("AssignedAgent")
  assignedTickets       Ticket[]       @relation("AssignedTicketAgent")
  notes                 Note[]

  @@index([organizationId])
  @@index([passwordResetToken])
  @@map("users")
}

model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  keyName        String
  keyHash        String       @unique
  keyPrefix      String
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("api_keys")
}

model TelephonyConfig {
  id               String                @id @default(uuid())
  organizationId   String
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider         TelephonyProviderType @default(TWILIO)
  accountSid       String?
  authToken        String?
  apiKey           String?
  apiSecret        String?
  phoneNumber      String
  forwardingNumber String? // Nigerian local number forwarding target (e.g. MTN/Airtel/Glo/9mobile)
  isDefault        Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  callLogs CallLog[]

  @@index([organizationId])
  @@index([phoneNumber])
  @@map("telephony_configs")
}

model WhatsAppConfig {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneNumberId      String
  whatsappBusinessId String
  accessToken        String       @db.Text
  displayPhoneNumber String
  webhookVerifyToken String
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId])
  @@index([phoneNumberId])
  @@map("whatsapp_configs")
}

model Contact {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  fullName       String
  phoneNumber    String
  email          String?
  address        String?
  city           String?
  state          String?
  tags           String[]     @default([])
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  leads          Lead[]
  deals          Deal[]
  tickets        Ticket[]
  conversations  Conversation[]
  callLogs       CallLog[]
  bookings       Booking[]
  reservations   Reservation[]
  notes          Note[]
  selfieRequests SelfieRequest[]

  @@unique([organizationId, phoneNumber])
  @@index([organizationId, createdAt])
  @@index([companyId])
  @@map("contacts")
}

model Company {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  industry       String?
  website        String?
  phone          String?
  email          String?
  address        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  contacts Contact[]

  @@index([organizationId])
  @@map("companies")
}

model Lead {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  source         String       @default("AI_ASSISTANT")
  status         LeadStatus   @default(NEW)
  score          Int          @default(0)
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@index([contactId])
  @@map("leads")
}

model Deal {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title          String
  amount         Float        @default(0.0)
  currency       String       @default("NGN")
  stage          DealStage    @default(DISCOVERY)
  expectedClose  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@index([contactId])
  @@map("deals")
}

model Ticket {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUserId String?
  assignedUser   User?          @relation("AssignedTicketAgent", fields: [assignedUserId], references: [id], onDelete: SetNull)
  ticketNumber   String         @unique
  subject        String
  description    String         @db.Text
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, createdAt])
  @@index([contactId])
  @@index([assignedUserId])
  @@map("tickets")
}

model Note {
  id           String   @id @default(uuid())
  contactId    String
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorUserId String?
  authorUser   User?    @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  content      String   @db.Text
  createdAt    DateTime @default(now())

  @@index([contactId])
  @@map("notes")
}

model Conversation {
  id                   String         @id @default(uuid())
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId            String
  contact              Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel              ChannelType    @default(WHATSAPP)
  isHumanHandoffActive Boolean        @default(false)
  handoffReason        HandoffReason?
  assignedUserId       String?
  assignedUser         User?          @relation("AssignedAgent", fields: [assignedUserId], references: [id], onDelete: SetNull)
  lastMessageAt        DateTime       @default(now())
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  messages Message[]

  // WhatsappService.upsertConversation and WidgetService both use a
  // find-then-create pattern and catch Prisma P2002 to resolve the race.
  // That only works if the constraint actually exists — without it two
  // concurrent inbound messages created two conversations for the same
  // contact and the history silently split in half.
  @@unique([organizationId, contactId, channel])
  @@index([organizationId, lastMessageAt])
  @@index([contactId])
  @@map("conversations")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MessageSender
  content        String        @db.Text
  mediaUrl       String?
  mediaType      String?
  metadata       Json?
  sentAt         DateTime      @default(now())

  /// Provider message id — Meta's `wamid`, and the equivalent for other channels.
  ///
  /// UNIQUE, and that is the whole point. Meta's webhook delivery is *at least once*:
  /// it retries on timeout, on network error, and sometimes for no visible reason. With
  /// no constraint here a retry wrote a second copy of the customer's message and ran
  /// the assistant again, so the customer was answered twice and the transcript showed
  /// them saying everything twice. A check-then-insert cannot close that — two retries
  /// can be in flight at once — so the database enforces it.
  ///
  /// Null for messages we originate ourselves, which have no provider id. Postgres
  /// permits many NULLs in a unique column, so that is safe.
  externalId     String?       @unique

  @@index([conversationId, sentAt])
  @@map("messages")
}

model CallLog {
  id                String                @id @default(uuid())
  organizationId    String
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  telephonyConfigId String?
  telephonyConfig   TelephonyConfig?      @relation(fields: [telephonyConfigId], references: [id], onDelete: SetNull)
  contactId         String?
  contact           Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  callSid           String                @unique
  fromNumber        String
  toNumber          String
  direction         CallDirection         @default(INBOUND)
  status            CallStatus            @default(QUEUED)
  durationSeconds   Int                   @default(0)
  recordingUrl      String?
  transcript        String?               @db.Text
  summary           String?               @db.Text
  sentiment         String?
  provider          TelephonyProviderType @default(TWILIO)
  startedAt         DateTime              @default(now())
  endedAt           DateTime?

  @@index([organizationId, startedAt])
  @@index([contactId])
  @@map("call_logs")
}

model KnowledgeDocument {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  fileName       String
  fileSize       Int
  mimeType       String
  storageUrl     String
  status         DocStatus    @default(PENDING)
  chunkCount     Int          @default(0)
  errorMessage   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  chunks DocumentChunk[]

  @@index([organizationId, createdAt])
  @@map("knowledge_documents")
}

model DocumentChunk {
  id             String            @id @default(uuid())
  documentId     String
  document       KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organizationId String
  chunkIndex     Int
  content        String            @db.Text
  qdrantVectorId String?
  createdAt      DateTime          @default(now())

  @@index([documentId, chunkIndex])
  @@index([organizationId])
  @@map("document_chunks")
}

model Booking {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  serviceName    String
  staffName      String?
  startTime      DateTime
  endTime        DateTime
  status         BookingStatus @default(CONFIRMED)
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, startTime])
  @@index([contactId])
  @@index([status, startTime])
  @@map("bookings")
}

model Reservation {
