}

model WebhookLog {
  id             String    @id @default(uuid())
  organizationId String
  eventType      String
  payload        Json
  targetUrl      String
  statusCode     Int?
  success        Boolean   @default(false)
  error          String?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId, createdAt])
  @@map("webhook_logs")
}

model WhatsAppTemplate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  language       String       @default("en_US")
  category       String       @default("MARKETING")
  headerType     String?
  headerContent  String?
  bodyText       String       @db.Text
  footerText     String?
  buttons        Json?
  status         String       @default("APPROVED")
  metaTemplateId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  campaigns BroadcastCampaign[]

  @@unique([organizationId, name, language])
  @@map("whatsapp_templates")
}

model BroadcastCampaign {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId     String
  template       WhatsAppTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name           String
  recipients     String[]
  totalCount     Int              @default(0)
  sentCount      Int              @default(0)
  failedCount    Int              @default(0)
  status         String           @default("COMPLETED")
  variables      Json?
  sentAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId, createdAt])
  @@map("broadcast_campaigns")
}

model Workflow {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  triggerType    String       @default("WHATSAPP_INBOUND")
  nodes          Json
  edges          Json
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  runs WorkflowRun[]

  @@index([organizationId, triggerType, isActive])
  @@map("workflows")
}

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  // Retries exhausted. The run is parked for inspection and manual replay rather
  // than being silently dropped.
  DEAD_LETTER
}

enum WorkflowStepStatus {
  SUCCEEDED
  FAILED
  // Condition evaluated false, or the step is downstream of one that did.
  SKIPPED
}

/// One execution of one workflow against one trigger payload.
///
/// Execution history is not a nicety here: without it, "did my automation run?" is
/// unanswerable, and a failed action disappears with no trace. Every trigger creates
/// a row before any action is attempted.
model WorkflowRun {
  id             String            @id @default(uuid())
  organizationId String
  workflowId     String
  workflow       Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  triggerType    String
  status         WorkflowRunStatus @default(QUEUED)
  /// The domain event payload the workflow was evaluated against.
  payload        Json
  /// Retry counter; compared against the queue's attempt limit.
  attempt        Int               @default(0)
  error          String?           @db.Text
  /// True when Redis was unavailable and the run executed in the request path.
  ranInline      Boolean           @default(false)
  queuedAt       DateTime          @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  steps WorkflowRunStep[]

  @@index([organizationId, queuedAt])
  @@index([workflowId, queuedAt])
  @@index([status])
  @@map("workflow_runs")
}

/// One node's execution within a run. Records what was attempted and what happened,
/// so a partially-completed workflow can be diagnosed node by node.
model WorkflowRunStep {
  id         String             @id @default(uuid())
  runId      String
  run        WorkflowRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId     String
  /// ACTION type, CONDITION, or DELAY.
  kind       String
  action     String?
  status     WorkflowStepStatus
  /// Resolved configuration actually used (after template interpolation).
  input      Json?
  /// What the action returned — e.g. the created ticket id, the wamid of a sent message.
  output     Json?
  error      String?            @db.Text
  startedAt  DateTime           @default(now())
  finishedAt DateTime?

  @@index([runId, startedAt])
  @@map("workflow_run_steps")
}

// ─── Onboarding selfie capture ────────────────────────────────────────────────
//
// A customer being onboarded over WhatsApp or a phone call can be asked for a
// selfie. Two facts shape this model:
//
//  1. A voice call cannot carry an image. The only honest implementation is to send
//     the customer a one-time upload link over a channel that can — so the request
//     row, not the channel, is the unit of work, and it records both where it was
//     requested (`channel`) and where the image actually arrived (`receivedVia`).
//
//  2. This is CAPTURE, not identity verification. Nothing here proves the face is
//     real, live, or the account holder's. `verifiedAt` exists for a future
//     biometric provider and is never set by this system, so no downstream code can
//     mistake a stored photo for a verified identity.

enum SelfieRequestStatus {
  PENDING
  RECEIVED
  EXPIRED
  CANCELLED
}

enum SelfieChannel {
  WHATSAPP
  VOICE
  WEB
}

model SelfieRequest {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// Where the request originated. WHATSAPP prompts in-thread; VOICE always sends a link.
  channel        SelfieChannel
  status         SelfieRequestStatus @default(PENDING)
  /// Shown to the customer, e.g. "account verification". Free text, operator-supplied.
  purpose        String?
  /// Conversation / call this belongs to, when there is one.
  conversationId String?
  callSid        String?

  /// SHA-256 of the one-time upload token. The raw token exists only in the link
  /// sent to the customer — storing it would let anyone with read access to this
  /// table upload on that customer's behalf.
  tokenHash String   @unique
  expiresAt DateTime
  /// Failed/attempted uploads against this token. Capped, so a leaked link cannot be
  /// brute-forced or used as an upload endpoint.
  attempts  Int      @default(0)

  /// Supabase Storage path — never a public URL. Access is via short-lived signed URLs.
  storagePath     String?
  mimeType        String?
  sizeBytes       Int?
  receivedAt      DateTime?
  receivedVia     SelfieChannel?
  rejectionReason String?

  /// Reserved for a future biometric provider. This system never sets it.
  verifiedAt DateTime?

  requestedByUserId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([contactId, status])
  @@index([status, expiresAt])
  @@map("selfie_requests")
}

/// Per-tenant configuration for a hosted conversational agent (ElevenLabs
/// Agents). The agent runs the conversation; this platform runs the business
/// logic and is called back through /api/agent-tools.
///
/// One row per organization per channel target. The API key is stored because
/// outbound calls and messages are initiated BY US on the tenant's behalf —
/// inbound needs no key, since the agent authenticates to us with its own
/// agent key instead.
model HostedAgentConfig {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// ElevenLabs agent id (agent_...). Identifies which configured agent runs.
  agentId String

  /// Workspace API key used for outbound initiation (xi-api-key).
  apiKey String? @db.Text

  /// ElevenLabs-side WhatsApp number id — NOT the Meta phone_number_id.
  whatsappPhoneNumberId String?

  /// Template used to request call permission before an outbound WhatsApp call.
  /// WhatsApp requires an approved template; without one the call cannot be placed.
  callPermissionTemplateName     String?
  callPermissionTemplateLanguage String? @default("en")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hosted_agent_configs")
}
