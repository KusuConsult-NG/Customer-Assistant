# ═══════════════════════════════════════════════════════════════════════════
# ACE Platform — local development environment.
#
#   cp .env.example .env
#
# Then edit DATABASE_URL if your Postgres is elsewhere. Everything else works
# as written for a local run.
#
# ⚠ POINT THIS AT A LOCAL DATABASE, NEVER PRODUCTION. The validation harness
#   and channel probes create real organizations through the real API — that
#   is why they catch bugs mocks do not. Pointed at production once, they left
#   358 test organizations and ~13,900 contacts sitting in the live CRM.
# ═══════════════════════════════════════════════════════════════════════════


# ─── Database (required) ───────────────────────────────────────────────────
# Locally both point at the same database. In production DATABASE_URL uses the
# Supabase pooler in transaction mode (port 6543, pgbouncer=true) and
# DIRECT_URL stays on 5432 for migrations.
DATABASE_URL=postgresql://ace@127.0.0.1:5432/ace_dev
DIRECT_URL=postgresql://ace@127.0.0.1:5432/ace_dev


# ─── Auth (required — the API refuses to boot without these) ───────────────
# No fallback exists anywhere in the code, deliberately. Minimum 32 characters.
# Generate real ones with:  openssl rand -base64 48
JWT_SECRET=local-dev-only-jwt-secret-change-me-0123456789abcd
JWT_REFRESH_SECRET=local-dev-only-refresh-secret-change-me-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d


# ─── AI provider (required) ────────────────────────────────────────────────
# ⚠ Startup validation REJECTS any value containing the word "placeholder".
#   That check is deliberate — it caught real deploys shipping with dummy
#   keys — so use a real-looking dummy locally, not the word placeholder.
#
# The key authenticates whichever OpenAI-COMPATIBLE provider LLM_BASE_URL
# points at. Several serve the same wire format on a free plan (Groq, Gemini's
# OpenAI-compat endpoint, OpenRouter, Cerebras) — check their current terms.
# With no working key the assistant still answers from curated FAQs and hands
# off everything else honestly; it never invents an answer.
OPENAI_API_KEY=sk-local-dev-0000000000000000
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536


# ─── WhatsApp webhook validation (required to boot) ────────────────────────
# These two are checked at startup even when WhatsApp is unused. The app
# secret is what signatures are verified against; the verify token must match
# what you enter in the Meta Developer Console.
WHATSAPP_APP_SECRET=local_dev_app_secret
WHATSAPP_VERIFY_TOKEN=local_dev_verify_token


# ─── Optional: everything below degrades honestly when unset ───────────────

# Redis. Without it: single pod only — uploads index inline (text types only),
# workflows run on the inline sweeper, rate limiting is in-memory.
REDIS_URL=redis://127.0.0.1:6379

# Public URLs. WEB_BASE_URL is used to build emailed verification links and
# selfie-capture links; unset, customers receive localhost links.
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# File uploads. Both buckets must be created manually and be PRIVATE:
# knowledge-documents and onboarding-selfies. Unset, document upload and
# selfie capture return an honest 503 and nothing else is affected.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Voice. All three are needed before a call can be answered. Unset, the voice
# probe BLOCKS rather than reporting failure — an unconfigured channel and a
# broken one must never look alike.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=

# Vector search. Unset, knowledge search uses the PostgreSQL keyword fallback.
# QDRANT_URL=
# QDRANT_API_KEY=

# Email delivery. Unset, registration returns the verification link in the
# response instead of sending it, and says so.
# RESEND_API_KEY=

# Payments.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_WEBHOOK_SECRET=

# Behind a load balancer only. Without it every user is rate-limited as one
# shared IP; with it set on a directly-exposed deploy, a forged
# X-Forwarded-For can spoof the client IP. Opt in deliberately.
# TRUST_PROXY=1
