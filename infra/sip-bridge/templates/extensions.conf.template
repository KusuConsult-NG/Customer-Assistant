; Dialplan for the SIP bridge. Rendered by setup.sh.

[general]
static = yes
writeprotect = yes

; Every call Alphatech delivers to extension ${ALPHATECH_EXTENSION}, whatever
; number the INVITE carries, goes to the ElevenLabs agent as the toll-free DID.
[from-alphatech]
exten => _[+0-9a-zA-Z*#].,1,Goto(bridge,s,1)
exten => s,1,Goto(bridge,s,1)

[bridge]
exten => s,1,NoOp(Inbound from Alphatech: caller=${CALLERID(num)} dialled=${EXTEN})
 ; Callers' numbers to E.164, so officers can ring them back (also from the
 ; waiting room's callback):
 ;   08031234567 → +2348031234567 ; 2348031234567 → +2348031234567
 same => n,Set(CN=${CALLERID(num)})
 same => n,ExecIf($[${REGEX("^0[789][01][0-9]{8}$" ${CN})}]?Set(CALLERID(num)=+234${CN:1}))
 same => n,ExecIf($[${REGEX("^234[0-9]{10}$" ${CN})}]?Set(CALLERID(num)=+${CN}))
 ; Hard ceiling on total simultaneous calls (default 30) across all voice paths.
 ; A caller beyond it, or arriving while others already wait, goes to the
 ; waiting room ([queue]) instead of a busy tone: first come, first served.
 same => n,Set(GROUP()=inbound)
 same => n,GotoIf($[${GROUP_COUNT(inbound)} > ${MAX_CONCURRENT_CALLS} | ${GROUP_COUNT(waiting)} > 0]?queue,s,1)
 same => n(admitted),GotoIf($["${LOCAL_VOICE}" != "1"]?elevenlabs)

 ; ── The server's own voice line (LOCAL_VOICE=1) ──────────────────────────
 ; Ask the API whether it can take this call. Anything but "ok <uuid>" — the
 ; API down, a provider key missing, an unknown number, a wrong secret — sends
 ; the call to ElevenLabs below, exactly as before this existed.
 same => n,Set(CURLOPT(conntimeout)=2)
 same => n,Set(CURLOPT(httptimeout)=4)
 same => n,Set(LV=${CURL(http://127.0.0.1:${API_PORT}/api/voice-local/register,secret=${LOCAL_VOICE_SECRET}&from=${URIENCODE(${CALLERID(num)})}&to=${URIENCODE(${TOLLFREE_E164})})})
 same => n,NoOp(voice-local register: ${LV})
 same => n,GotoIf($["${LV:0:3}" != "ok "]?elevenlabs)
 same => n,Answer()
 ; NO jitter buffer on this path. One was added here on 27 Nov 2026
 ; (JITTERBUFFER(adaptive)=300,60,40) and the caller's audio stopped reaching
 ; the voice line: a 52 s call delivered 0.4 s of it, and the assistant asked
 ; its question and never heard the answer. Removed from the running bridge,
 ; the next call delivered 37.5 s of 38. Speech recognition needs no playout
 ; smoothing; a jitter buffer is for audio played to a person.
 ; Dial(AudioSocket/…), NOT the AudioSocket() application: tested on Asterisk
 ; 20.6, the application HANGS UP the caller when the server closes, so the
 ; fallback below could never run. A dialled AudioSocket leg ending returns
 ; here (option g), whatever the reason.
 ; c(slin): 16-bit linear at 8 kHz, which is what the voice line reads and
 ; writes. Without it the leg takes the CALLER's codec, so the caller's audio
 ; arrived as 8-bit µ-law, was read as 16-bit, and speech recognition heard
 ; only noise: the assistant spoke and never heard a word.
 same => n,Dial(AudioSocket/127.0.0.1:${AUDIOSOCKET_PORT}/${LV:3}/c(slin),,g)
 ; The local leg ended. "fallback" means it failed (the caller is still on
 ; the line): hand them to the ElevenLabs agent. Anything else: hang up.
 same => n,Set(LVO=${CURL(http://127.0.0.1:${API_PORT}/api/voice-local/outcome/${LV:3}?secret=${LOCAL_VOICE_SECRET})})
 same => n,NoOp(voice-local outcome: ${LVO})
 same => n,GotoIf($["${LVO}" = "fallback"]?elevenlabs)
 same => n,GotoIf($["${LVO}" = "unknown"]?elevenlabs)
 same => n,Hangup()

 ; ── ElevenLabs (the original path, and the fallback) ─────────────────────
 ; If INTRO_SOUND is set (e.g. Governor Caleb Mutfwang's recorded welcome),
 ; answer and play it before handing the call to Nanpan on ElevenLabs.
 ; Who is calling, asked of the platform BEFORE the agent answers, so a
 ; caller profiled on an earlier call is welcomed back by name in the first
 ; message — not left to the model remembering to look them up. The answer
 ; travels as X- headers, which ElevenLabs turns into {{sip_...}} variables.
 ; At most a few seconds; no answer at all and the call goes on as before.
 same => n(elevenlabs),Set(CI=)
 same => n,GotoIf($["${SIP_BRIDGE_SECRET}" = ""]?dial)
 same => n,Set(CURLOPT(conntimeout)=2)
 same => n,Set(CURLOPT(httptimeout)=3)
 same => n,Set(CI=${CURL(${BRIDGE_API_URL}/api/sip-bridge/caller,secret=${SIP_BRIDGE_SECRET}&from=${URIENCODE(${CALLERID(num)})}&to=${URIENCODE(${TOLLFREE_E164})})})
 same => n,ExecIf($["${CI:0:3}" != "ok|"]?Set(CI=))
 ; __ so the outgoing (ElevenLabs) channel inherits it for the headers below.
 same => n,Set(__CALLERINFO=${CI})
 same => n,NoOp(caller lookup: ${CUT(CI,|,2)})
 same => n(dial),ExecIf($["${INTRO_SOUND}" != "" & "${LV:0:3}" != "ok "]?Answer())
 same => n,ExecIf($["${INTRO_SOUND}" != "" & "${LV:0:3}" != "ok "]?Playback(${INTRO_SOUND}))
 ; Smooth out intercontinental UDP jitter (Lagos <-> ElevenLabs) so late RTP
 ; packets are played smoothly instead of dropped/skipped.
 same => n,Set(JITTERBUFFER(adaptive)=300,60,40)
 same => n,Dial(PJSIP/elevenlabs/sip:${TOLLFREE_E164}@${ELEVENLABS_SIP_HOST}:5060\;transport=tcp,60,b(caller-headers^s^1))
 same => n,NoOp(ElevenLabs leg ended: DIALSTATUS=${DIALSTATUS} HANGUPCAUSE=${HANGUPCAUSE})
 ; If the AI could not be reached, the caller is told rather than dropped.
 same => n,ExecIf($["${DIALSTATUS}" != "ANSWER"]?Playback(${FALLBACK_SOUND}))
 same => n,Hangup()

 ; Hard ceiling reached with the waiting room switched off (QUEUE_MAX_CALLS=0):
 ; SIP 486 Busy Here, as before the waiting room existed.
 same => n(ceiling),NoOp(Concurrent call ceiling reached: ${GROUP_COUNT(inbound)} > ${MAX_CONCURRENT_CALLS})
 same => n,Busy(5)
 same => n,Hangup(17)

; ── The waiting room ──────────────────────────────────────────────────────
; Every line is busy: the caller is answered, told so, and held, strictly in
; the order they called (a numbered ticket taken under a lock). As soon as a
; line is free and their ticket is next, they continue into the normal path
; above (bridge,s,admitted). After QUEUE_MAX_WAIT seconds, or when the room
; itself is full (QUEUE_MAX_CALLS), they are offered a callback instead: a
; callback request for their number is put in the agency's queue and they
; hear that a desk officer will call them back. Each step is reported to the
; API for the System Health page. A caller who hangs up while waiting leaves
; their ticket marked, and the queue moves past it.
[queue]
exten => s,1,NoOp(Every line busy: ${GROUP_COUNT(inbound)} active, ${GROUP_COUNT(waiting)} waiting)
 same => n,GotoIf($[${QUEUE_MAX_CALLS} <= 0]?bridge,s,ceiling)
 same => n,Set(GROUP()=waiting)
 same => n,Set(CURLOPT(conntimeout)=2)
 same => n,Set(CURLOPT(httptimeout)=4)
 same => n,GotoIf($[${GROUP_COUNT(waiting)} > ${QUEUE_MAX_CALLS}]?full)
 same => n,Answer()
 ; The tickets: QNEXT is the last one handed out, QSERVE the last one let
 ; through, and QGONE_n marks a ticket whose caller left. NOT set in [globals]:
 ; a `dialplan reload` re-applies [globals], and resetting the counters while
 ; callers wait would hand out their ticket numbers again (found in testing,
 ; 28 Nov 2026). Unset (Asterisk just started) counts as 0.
 same => n,Set(L=${LOCK(ace-queue)})
 same => n,ExecIf($["${GLOBAL(QNEXT)}" = ""]?Set(GLOBAL(QNEXT)=0))
 same => n,ExecIf($["${GLOBAL(QSERVE)}" = ""]?Set(GLOBAL(QSERVE)=0))
 same => n,Set(GLOBAL(QNEXT)=$[${GLOBAL(QNEXT)} + 1])
 same => n,Set(MYT=${GLOBAL(QNEXT)})
 ; A fresh ticket is never already marked as left.
 same => n,Set(GLOBAL(QGONE_${MYT})=)
 same => n,Set(U=${UNLOCK(ace-queue)})
 same => n,Set(QSTART=${EPOCH})
 same => n,Set(CHANNEL(hangup_handler_push)=queue-gone,s,1)
 same => n,Set(QEV=${CURL(http://127.0.0.1:${API_PORT}/api/voice-local/queue-event,secret=${LOCAL_VOICE_SECRET}&event=joined&ticket=${MYT}&waiting=${GROUP_COUNT(waiting)})})
 same => n,Playback(${QUEUE_SOUNDS}/queue-hold)
 same => n,ExecIf($["${PLAYBACKSTATUS}" != "SUCCESS"]?Playback(pls-hold-while-try))
 same => n,Set(QANN=$[${EPOCH} + 60])
 same => n(loop),GotoIf($[${EPOCH} - ${QSTART} >= ${QUEUE_MAX_WAIT}]?timeout)
 same => n,Set(L=${LOCK(ace-queue)})
 ; Move the queue past tickets whose callers hung up.
 same => n(skip),GotoIf($["${GLOBAL(QGONE_$[${GLOBAL(QSERVE)} + 1])}" != "1"]?head)
 same => n,Set(GLOBAL(QGONE_$[${GLOBAL(QSERVE)} + 1])=)
 same => n,Set(GLOBAL(QSERVE)=$[${GLOBAL(QSERVE)} + 1])
 same => n,Goto(skip)
 ; Next in line (or already passed: never left waiting for a turn that went by).
 same => n(head),GotoIf($[${MYT} > $[${GLOBAL(QSERVE)} + 1] | ${GROUP_COUNT(inbound)} >= ${MAX_CONCURRENT_CALLS}]?notyet)
 ; This caller's turn, and a line is free.
 same => n,ExecIf($[${MYT} > ${GLOBAL(QSERVE)}]?Set(GLOBAL(QSERVE)=${MYT}))
 same => n,Set(GROUP()=inbound)
 same => n,Set(U=${UNLOCK(ace-queue)})
 same => n,Set(CHANNEL(hangup_handler_pop)=)
 same => n,Set(QEV=${CURL(http://127.0.0.1:${API_PORT}/api/voice-local/queue-event,secret=${LOCAL_VOICE_SECRET}&event=admitted&ticket=${MYT}&wait=$[${EPOCH} - ${QSTART}])})
 same => n,Goto(bridge,s,admitted)
 same => n(notyet),Set(U=${UNLOCK(ace-queue)})
 same => n,GotoIf($[${EPOCH} < ${QANN}]?tone)
 same => n,Playback(${QUEUE_SOUNDS}/queue-still)
 same => n,ExecIf($["${PLAYBACKSTATUS}" != "SUCCESS"]?Playback(queue-periodic-announce))
 same => n,Set(QANN=$[${EPOCH} + 60])
 same => n(tone),Playback(${QUEUE_SOUNDS}/queue-tone)
 same => n,ExecIf($["${PLAYBACKSTATUS}" != "SUCCESS"]?Wait(2))
 same => n,Goto(loop)
 ; Waited QUEUE_MAX_WAIT: give up the place (the ticket is skipped) and offer the callback.
 same => n(timeout),Set(CHANNEL(hangup_handler_pop)=)
 same => n,Set(GLOBAL(QGONE_${MYT})=1)
 same => n,Set(GROUP()=)
 same => n,Set(QEV=${CURL(http://127.0.0.1:${API_PORT}/api/voice-local/queue-event,secret=${LOCAL_VOICE_SECRET}&event=timeout&ticket=${MYT}&wait=$[${EPOCH} - ${QSTART}])})
 same => n,Goto(callback)
 ; The waiting room itself is full: straight to the callback.
 same => n(full),Set(GROUP()=)
 same => n,Answer()
 same => n,Set(QEV=${CURL(http://127.0.0.1:${API_PORT}/api/voice-local/queue-event,secret=${LOCAL_VOICE_SECRET}&event=full)})
 same => n(callback),Set(QCB=${CURL(http://127.0.0.1:${API_PORT}/api/voice-local/queue-callback,secret=${LOCAL_VOICE_SECRET}&from=${URIENCODE(${CALLERID(num)})}&to=${URIENCODE(${TOLLFREE_E164})})})
 same => n,NoOp(queue callback: ${QCB})
 same => n,GotoIf($["${QCB:0:3}" = "ok "]?promised)
 ; No number to call back (withheld) or the API did not answer: ask them to call again.
 same => n,Playback(${QUEUE_SOUNDS}/queue-later)
 same => n,ExecIf($["${PLAYBACKSTATUS}" != "SUCCESS"]?Playback(queue-thankyou))
 same => n,Hangup()
 same => n(promised),Playback(${QUEUE_SOUNDS}/queue-callback)
 same => n,ExecIf($["${PLAYBACKSTATUS}" != "SUCCESS"]?Playback(queue-thankyou))
 same => n,Hangup()

; A caller who hangs up in the waiting room: their ticket is skipped.
[queue-gone]
exten => s,1,Set(GLOBAL(QGONE_${MYT})=1)
 same => n,Set(QEV=${CURL(http://127.0.0.1:${API_PORT}/api/voice-local/queue-event,secret=${LOCAL_VOICE_SECRET}&event=abandoned&ticket=${MYT}&wait=$[${EPOCH} - ${QSTART}])})
 same => n,Return()

; Runs on the OUTGOING leg to ElevenLabs just before the INVITE is sent: the
; caller lookup as headers. X-Callerstatus becomes {{sip_callerstatus}}, etc.
[caller-headers]
exten => s,1,Set(JITTERBUFFER(adaptive)=300,60,40)
 same => n,GotoIf($["${CALLERINFO}" = ""]?done)
 same => n,Set(PJSIP_HEADER(add,X-Callerstatus)=${CUT(CALLERINFO,|,2)})
 same => n,Set(PJSIP_HEADER(add,X-Callername)=${CUT(CALLERINFO,|,3)})
 same => n,Set(PJSIP_HEADER(add,X-Callerprofile)=${CUT(CALLERINFO,|,4)})
 same => n,Set(PJSIP_HEADER(add,X-Callermissing)=${CUT(CALLERINFO,|,5)})
 same => n,Set(PJSIP_HEADER(add,X-Welcome)=${CUT(CALLERINFO,|,6)})
 same => n(done),Return()

; Nothing is accepted FROM ElevenLabs on this bridge: officer callbacks go out
; through ElevenLabs' own outbound trunk straight to Alphatech.
[from-elevenlabs]
exten => _X.,1,Hangup(21)
