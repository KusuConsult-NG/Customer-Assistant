; Dialplan for the SIP bridge. Rendered by setup.sh.

[general]
static = yes
writeprotect = yes

; Every call Alphatech delivers to extension ${ALPHATECH_EXTENSION}, whatever
; number the INVITE carries, goes to the ElevenLabs agent as the toll-free DID.
[from-alphatech]
exten => _[+0-9a-zA-Z*#].,1,Goto(bridge,s,1)
exten => s,1,Goto(bridge,s,1)

[bridge]
exten => s,1,NoOp(Inbound from Alphatech: caller=${CALLERID(num)} dialled=${EXTEN})
 ; Callers' numbers to E.164, so officers can ring them back:
 ;   08031234567 → +2348031234567 ; 2348031234567 → +2348031234567
 same => n,Set(CN=${CALLERID(num)})
 same => n,ExecIf($[${REGEX("^0[789][01][0-9]{8}$" ${CN})}]?Set(CALLERID(num)=+234${CN:1}))
 same => n,ExecIf($[${REGEX("^234[0-9]{10}$" ${CN})}]?Set(CALLERID(num)=+${CN}))
 same => n,Dial(PJSIP/elevenlabs/sip:${TOLLFREE_E164}@${ELEVENLABS_SIP_HOST}:5060\;transport=tcp,60)
 same => n,NoOp(ElevenLabs leg ended: DIALSTATUS=${DIALSTATUS} HANGUPCAUSE=${HANGUPCAUSE})
 ; If the AI could not be reached, the caller is told rather than dropped.
 same => n,ExecIf($["${DIALSTATUS}" != "ANSWER"]?Playback(${FALLBACK_SOUND}))
 same => n,Hangup()

; Nothing is accepted FROM ElevenLabs on this bridge: officer callbacks go out
; through ElevenLabs' own outbound trunk straight to Alphatech.
[from-elevenlabs]
exten => _X.,1,Hangup(21)
