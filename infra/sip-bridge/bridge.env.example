# Copy to bridge.env, fill in, then: sudo ./setup.sh
# Secrets live only in this file on the server (chmod 600). Never commit it.

# ── Alphatech PBX: the extension this server registers as ──
ALPHATECH_HOST=kusuconsult.alphatechpbx.com
ALPHATECH_IP=197.253.11.119
ALPHATECH_EXTENSION=1000
ALPHATECH_PASSWORD=

# ── ElevenLabs: where calls are sent ──
# The same username/password set on the ElevenLabs phone number's INBOUND trunk.
ELEVENLABS_SIP_HOST=sip.rtc.elevenlabs.io
ELEVENLABS_SIP_USERNAME=1000
ELEVENLABS_SIP_PASSWORD=

# The toll-free number exactly as imported in ElevenLabs (E.164).
TOLLFREE_E164=+2348000000456

# Optional: pre-recorded welcome audio (e.g. Governor's welcome message at
# /var/lib/asterisk/sounds/en/governor-welcome.wav -> set INTRO_SOUND=governor-welcome)
# played on the bridge right before Nanpan answers. Leave empty to skip.
INTRO_SOUND=

# Played if ElevenLabs cannot be reached ("all circuits are busy now…").
FALLBACK_SOUND=all-circuits-busy-now

# Leave empty to auto-detect this server's public IP.
PUBLIC_IP=
